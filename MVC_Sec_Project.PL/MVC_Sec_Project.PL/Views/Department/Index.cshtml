@model IEnumerable<DepartmentDto>
@{
    ViewData["Title"] = "Index";
}

@{
    var dept = ViewData["Department"] as DepartmentDto;
}

<div class="alert alert-success">
    @*     @ViewData["SuccessMessage"]
    @ViewBag.Msg  *@

    @dept?.Name
    <br />
    @ViewBag.Department02.Name
</div>
@if (!string.IsNullOrWhiteSpace(@TempData["Message"] as string))
{

    <div aria-live="polite" aria-atomic="true" class="toast-container position-fixed p-3" style="bottom: 25px; right:25px; z-index: 100;">
        <div class="toast fade show " role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto text-success">Success!!</strong>
                <small>Just now</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @TempData["Message"]
            </div>
        </div>
    </div>
}

<div class="card border border-primary">
    <div class="card-header bg-primary">
        <h1 class="text-white">All Departments</h1>
    </div>
    <div class="card-body">
        <a class="btn btn-success mb-3" asp-action="Create">Create New Department</a>
        @if (Model.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="text-center">
                    <tr>
                        <th>@Html.DisplayNameFor(d => d.Name)</th>
                        <th>@Html.DisplayNameFor(d => d.Code)</th>
                        <th>@Html.DisplayNameFor(d => d.Description)</th>
                        <th>Details</th>
                        <th>Update</th>
                        <th>Delete</th>

                    </tr>
                </thead>
                <tbody class="text-center">
                    @foreach (var Item in Model)
                    {
                        <tr class="text-center">
                            <td>@Item.Name</td>
                            <td>@Item.Code</td>
                            <td>@Item.Description</td>
                           @* code will be here *@
                         
                            @*  @Html.PartialAsync("_ButtonsPartialView", Item.Id) *@  
                                    <partial name="_ButtonsPartialView" model="Item.Id" />

                            <td>
                                @* <a class="btn btn-danger" asp-action="Delete" asp-route-Id="@Item.Id"><i class="fas fa-trash"></i>Delete</a> *@
                                <!-- Button trigger modal -->
                                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#DeleteDepartment">
                                    Delete
                                </button>
                            </td>

                        </tr>
                        <!-- Modal -->
                        <div class="modal fade" id="DeleteDepartment" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Are you sure you want to delete @Item.Name Department? </h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        ...
                                    </div>
                                    <div class="modal-footer">

                                        <form asp-action="Delete" asp-route-DeptId="@Item.Id" method="post">
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <div class="mt-4">
                                                <input type="submit" value="Delete" class="btn btn-danger" />
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            </div>
                                        </form>
                                       
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                <h2>No Department Found</h2>
            </div>
        }
    </div>
</div>



