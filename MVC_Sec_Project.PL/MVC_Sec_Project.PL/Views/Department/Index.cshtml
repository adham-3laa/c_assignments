
@using MVC_Sec_Project.Bll.Dto_s.DepartmentDto_s
@model IEnumerable<DepartmentDto>
@{
    ViewData["Title"] = "Index";
}
<div class="card  border border-primary">
    <div class="card-header">
        <h1 class="my-3">All Departments</h1>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <table class="table table-striped table-hover mt-2">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(d => d.Code)</th>
                        <th>@Html.DisplayNameFor(d => d.Name)</th>
                        <th>@Html.DisplayNameFor(d => d.Description)</th>
                        <th>Details</th>
                        <th>Update</th>
                        <th>Delete</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach(var dept in Model)
                    {
                        <tr>
                            <td>@dept.Code</td>
                            <td>@dept.Name</td>
                            <td>@dept.Description</td>
                            <td><a asp-action="Details" class="btn btn-primary">Details</a></td>
                            <td><a asp-action="Edit" class="btn btn-warning">Update</a></td>
                            <td><a asp-action="Delete" class=" btn btn-danger ">Delete</a></td>


                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info mt-2">
                <h2>No Departments Found !</h2>
            </div>

        }
    </div>
</div>



