@using MVC_Sec_Project.PL.ViewModels.DepartmentVms
@model DepartmentViewModel
@{
    ViewData["Title"] = "Edit";
}

<div class="card border border-primary">
    <div class="card-header  bg-primary">
        <h1 class="text-white">@Model.Name Department</h1>
    </div>
    <div class="card-body">


        <form asp-action="Edit" method="post">
            <input hidden asp-for="Id" />

            <div asp-validation-summary="All"></div>

            <partial name="PartialViews/_CreateEditPartialView" />

            <div class="mt-4 m-auto">
                <input class="btn btn-primary" type="submit" value="Update Department" />
                <a asp-action="Index" class="btn btn-outline-dark">Back to list</a>
            </div>
        </form>
    </div>
</div>

@section ValidationScripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
