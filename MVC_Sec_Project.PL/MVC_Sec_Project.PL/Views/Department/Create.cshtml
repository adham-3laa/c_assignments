@using MVC_Sec_Project.PL.ViewModels.DepartmentVms
@model DepartmentViewModel
@{
    ViewData["Title"] = "Create";
}

<div class="card border border-primary">
    <div class="card-header  bg-primary">
        <h1 class="text-white">Create New Department</h1>
    </div>
    <div class="card-body">


        <form asp-action="Create" method="post">




            <div asp-validation-summary="ModelOnly"></div>

            <partial name="PartialViews/_CreateEditPartialView" />

            <div class="mt-4 m-auto">
                <input class="btn btn-primary" type="submit" value="Create Department" />
                <a asp-action="Index" class="btn btn-outline-dark">Back to list</a>
            </div>
        </form>
    </div>
</div>


@section ValidationScripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}