@model DepartmentDetailsDto
@{
    ViewData["Title"] = "Delete";
}

<div class="card border border-primary">
    <div class="card-header bg-primary">
        <h1 class="text-white">Are you sure you want to delete @Model.Name Department?</h1>
    </div>

    <div class="card-body">

        <ul class="nav nav-tabs" id="departmentTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active" id="general-tab" data-bs-toggle="tab" href="#general" role="tab"
                   aria-controls="general" aria-selected="true">General</a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" id="administration-tab" data-bs-toggle="tab" href="#administration" role="tab"
                   aria-controls="administration" aria-selected="false">Administration</a>
            </li>
        </ul>

        <form asp-action="Delete" method="post">
            <!-- hidden field to pass ID -->
            <input type="hidden" asp-for="ID" name="DeptId" />

            <div class="tab-content" id="myTabContent">
                <!-- General Tab -->
                <div class="tab-pane fade show active p-4 border" id="general" role="tabpanel" aria-labelledby="general-tab">
                    <div class="row">
                        <div class="form-group col-6">
                            <label asp-for="Code" class="col-form-label"></label>
                            <input asp-for="Code" class="form-control" readonly />
                        </div>
                        <div class="form-group col-6">
                            <label asp-for="Name" class="col-form-label"></label>
                            <input asp-for="Name" class="form-control" readonly />
                        </div>
                        <div class="form-group col-12">
                            <label asp-for="Description" class="col-form-label"></label>
                            <input asp-for="Description" class="form-control" readonly />
                        </div>
                    </div>
                </div>

                <!-- Administration Tab -->
                <div class="tab-pane fade p-4 border" id="administration" role="tabpanel" aria-labelledby="administration-tab">
                    <div class="form-group col-12">
                        <label asp-for="CreatedBy" class="col-form-label"></label>
                        <input asp-for="CreatedBy" class="form-control" readonly />
                    </div>
                    <div class="form-group col-12">
                        <label class="col-form-label">CreatedOn</label>
                        <input asp-for="CreatedOn" class="form-control" readonly />
                    </div>
                    <div class="form-group col-12">
                        <label asp-for="LastModifiedBy" class="col-form-label"></label>
                        <input asp-for="LastModifiedBy" class="form-control" readonly />
                    </div>
                    <div class="form-group col-12">
                        <label asp-for="LastModifiedOn" class="col-form-label"></label>
                        <input asp-for="LastModifiedOn" class="form-control" readonly />
                    </div>
                </div>

                <div class="mt-4">
                    <input type="submit" class="btn btn-danger" value="Delete Department"
                           onclick="return confirm('Are you sure you want to delete this department?');" />
                    <a asp-action="Index" class="btn btn-outline-dark">Back To List</a>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </form>
    </div>
</div>